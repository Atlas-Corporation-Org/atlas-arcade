# One-domain routing for the Atlas Arcade hub (WorkAdventure + path routes),
# plus the launcher subdomain for the gethomepage tile dashboard.
# Copy into your Caddyfile, set your domains and BIND_IP, reload Caddy.
#
# Gotchas we hit (documented so you don't have to):
#   - /map-storage must be STRIPPED (handle_path); the app serves at root
#   - /upload (exact) goes to MAP-STORAGE (map upload API)
#   - /upload-file* goes to the UPLOADER (chat file uploads) — do NOT strip
#   - WebSockets need no special config in Caddy v2
#   - The world and the launcher are SEPARATE sites: both are Next.js apps
#     serving /_next/*, so they cannot share one hostname. The arcade
#     catch-all (including / and /_next/*) goes straight into the world
#     (play client START_ROOM_URL); homepage gets its own subdomain.

arcade.example.com {
	import atlas_nobak

	handle /ws/* {
		reverse_proxy 127.0.0.1:8101
	}
	handle_path /api/* {
		reverse_proxy 127.0.0.1:8102
	}
	handle_path /map-storage/* {
		reverse_proxy 127.0.0.1:8103
	}
	handle /upload {
		reverse_proxy 127.0.0.1:8103
	}
	handle /upload-file* {
		reverse_proxy 127.0.0.1:8104
	}
	handle /icon/* {
		uri strip_prefix /icon
		reverse_proxy 127.0.0.1:8105
	}
	handle /lettericons/* {
		uri strip_prefix /lettericons
		reverse_proxy 127.0.0.1:8105
	}
	# Everything else — including / and /_next/* — is the world (play client,
	# which opens START_ROOM_URL, so the root lands straight in-world).
	handle {
		reverse_proxy 127.0.0.1:8100
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}
	log {
		output file /var/log/caddy/arcade-access.log
		format json
	}
}

# gethomepage tile launcher on its own subdomain (Next.js /_next conflict
# with the play client — see gotcha at the top).
launcher.example.com {
	import atlas_nobak
	reverse_proxy 127.0.0.1:8106
}
